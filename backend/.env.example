# --- LINGKUNGAN (ENVIRONMENT) ---
NODE_ENV=production
PORT=3000

# --- DATABASE (SUPABASE POSTGRESQL) ---
# Dapatkan string koneksi (Connection String) ini dari Supabase -> Project Settings -> Database -> Connection string (URI)
# Ubah [YOUR-PASSWORD] dengan kata sandi database Anda
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma merekomendasikan direct URL untuk migration
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- KEAMANAN & AUTENTIKASI ---
# Gunakan string panjang acak untuk JWT Secret (misal hasil dari: openssl rand -base64 32)
JWT_SECRET="ganti_dengan_rahasia_jwt_anda_yang_sangat_panjang_dan_rumit"

# --- CORS (Cross-Origin Resource Sharing) ---
# Tentukan domain Frontend Anda (misal: https://prompthub.vercel.app)
# Jika ada lebih dari satu, pisahkan dengan koma
CORS_ORIGIN="https://prompthub.vercel.app"
